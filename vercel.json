{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/people-profiles/collect-by-url", "dest": "/server.js" },
    { "src": "/people-profiles/discover-by-name", "dest": "/server.js" },
    { "src": "/company-info/collect-by-url", "dest": "/server.js" },
    { "src": "/job-listings/collect-by-url", "dest": "/server.js" },
    { "src": "/job-listings/discover-by-keyword", "dest": "/server.js" },
    { "src": "/job-listings/discover-by-url", "dest": "/server.js" },
    { "src": "/posts/collect-by-url", "dest": "/server.js" },
    { "src": "/posts/discover-by-company-url", "dest": "/server.js" },
    { "src": "/posts/discover-by-profile-url", "dest": "/server.js" },
    { "src": "/people-search/collect-by-url", "dest": "/server.js" },
    { "src": "/instagram-profile/collect-by-url", "dest": "/server.js" },
    { "src": "/instagram-profile/discover-by-username", "dest": "/server.js" },
    { "src": "/instagram-reels/collect-by-url", "dest": "/server.js" },
    { "src": "/instagram-post/collect-by-url", "dest": "/server.js" },
    { "src": "/youtube-scraper/collect-by-url", "dest": "/server.js" },
    { "src": "/youtube-scraper/about-by-url", "dest": "/server.js" },
    { "src": "/facebook-profile-posts/collect-by-url", "dest": "/server.js" },
    { "src": "/facebook-profile-posts/discover-by-username", "dest": "/server.js" },
    { "src": "/facebook-post/collect-by-url", "dest": "/server.js" },
    { "src": "/facebook-event/collect-by-url", "dest": "/server.js" },
    { "src": "/facebook-event/discover-by-venue", "dest": "/server.js" },
    { "src": "/facebook-reels-profile/collect-by-url", "dest": "/server.js" },
    { "src": "/facebook-reviews/collect-by-url", "dest": "/server.js" },
    { "src": "/facebook-basic-profile/collect-by-url", "dest": "/server.js" },
    { "src": "/maps-scraper/collect-by-url", "dest": "/server.js" },
    { "src": "/trigger-dataset", "dest": "/server.js" },
    { "src": "/get-snapshot/(.*)", "dest": "/server.js" },
    { "src": "/health", "dest": "/server.js" },
    { "src": "/(.*\\.(css|js|html|png|jpg|jpeg|gif|svg|ico))", "dest": "/public/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
