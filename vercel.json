{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/people-profiles/collect-by-url", "destination": "/server.js" },
    { "source": "/people-profiles/discover-by-name", "destination": "/server.js" },
    { "source": "/company-info/collect-by-url", "destination": "/server.js" },
    { "source": "/job-listings/collect-by-url", "destination": "/server.js" },
    { "source": "/job-listings/discover-by-keyword", "destination": "/server.js" },
    { "source": "/job-listings/discover-by-url", "destination": "/server.js" },
    { "source": "/posts/collect-by-url", "destination": "/server.js" },
    { "source": "/posts/discover-by-company-url", "destination": "/server.js" },
    { "source": "/posts/discover-by-profile-url", "destination": "/server.js" },
    { "source": "/people-search/collect-by-url", "destination": "/server.js" },
    { "source": "/trigger-dataset", "destination": "/server.js" },
    { "source": "/get-snapshot/(.*)", "destination": "/server.js" },
    { "source": "/health", "destination": "/server.js" }
  ]
}
